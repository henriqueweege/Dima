@page "/"
@inherits HomePage
<MudGrid Justify="Justify.Center">
    <MudItem lg="6" md="12">
        <MudCard Class="pa-8">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Resumo Financeiro</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@(ShowValues? Icons.TwoTone.VisibilityOff: Icons.TwoTone.Visibility)" OnClick="ToggleShowValues" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <p>
                    <strong>SALDO</strong>
                </p>
                @if(Summary is null)
                {
                    <div class="d-flex align-center justify-center" style="height: 350px">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary"></MudProgressCircular>
                    </div>
                }
                else
                {
                    @if(Summary.Total > 0)
                    {
                        <MudText Color="Color.Success" Typo="Typo.h3">
                            @(ShowValues ? Summary.Total.ToString("C") : "R$********" )
                        </MudText>
                    }
                    else
                    {
                        <MudText Color="Color.Error" Typo="Typo.h3">
                            @(ShowValues ? Summary.Total.ToString("C") : "R$********" )
                        </MudText>
                    }

                    <br />
                    <p><strong>Entradas</strong>
                        <MudText Color="Color.Success" Typo="Typo.h3">
                            @(ShowValues ? Summary.Incomes.ToString("C") : "R$********")
                        </MudText>
                    </p>
                    <br />
                    <p>
                        <strong>Saídas</strong>
                        <MudText Color="Color.Error" Typo="Typo.h3">
                            @(ShowValues ? Summary.Expenses.ToString("C") : "R$********")
                        </MudText>
                    </p>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem lg="6" md="12">
        <MudCard Class="pa-8">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Receitas e Despesas</MudText>
            </MudCardHeader>
            <MudCardContent>
                <IncomeAndExpense/>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem lg="6" md="12">
        <MudCard Class="pa-8">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Entradas por Categoria</MudText>
            </MudCardHeader>
            <MudCardContent>
                <IncomeByCategory/>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem lg="6" md="12">
        <MudCard Class="pa-8">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Despesas por Categoria</MudText>
            </MudCardHeader>
            <MudCardContent>
                <ExpensesByCategoryChart/>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>